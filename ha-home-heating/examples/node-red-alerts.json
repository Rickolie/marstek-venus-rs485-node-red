    {
        "id": "a1b2c3d4e5f60007",
        "type": "function",
        "z": "a1b2c3d4e5f60001",
        "name": "Telegram message",
        "func": "// One message per alert. Recoveries get a check mark, problems a warning sign\nconst alert = msg.payload;\nconst icon = alert.state === \"ok\" ? \"✅\" : alert.state === \"error\" ? \"🚨\" : \"⚠️\";\nconst repeat = alert.repeat ? \" (still)\" : \"\";\n\nmsg.payload = {\n    chatId: msg.chat_id,\n    type: \"message\",\n    content: `${icon} ${alert.title}${repeat}`,\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 730,
        "y": 160,
        "wires": [
            [
                "a1b2c3d4e5f60008"
            ]
        ]
    },
