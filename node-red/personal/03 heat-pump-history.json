    {
        "type": "function",
        "name": "History per day",
        "func": "const DAY_MS = 86_400_000;\nconst HOUR_MS = 3_600_000;\nconst pad = (v) => String(v).padStart(2, \"0\");\nconst dayKey = (t) => { const d = new Date(t); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; };\nconst round = (v, digits) => (v === undefined || !isFinite(v)) ? undefined : Number(v.toFixed(digits));\nconst mean = (values) => values.length ? values.reduce((a, b) => a + b, 0) / values.length : undefined;\nconst today = dayKey(Date.now()); // incomplete, never used\n\n// Time-weighted average per local day, from the time segments.\n// include() selects the values that take part in the average.\nconst s = msg.settings;\nfunction perDay(segments, include = () => true) {\n    const days = {};\n    segments.forEach(seg => {\n        let start = seg.start;\n        while (start < seg.end) {\n            const d = new Date(start);\n            const end = Math.min(seg.end, new Date(d.getFullYear(), d.getMonth(), d.getDate() + 1).getTime());\n            const day = days[dayKey(start)] ??= { sum: 0, ms: 0, covered_ms: 0, running_ms: 0 };\n            day.covered_ms += end - start;\n            if (include(seg.v)) { day.sum += seg.v * (end - start); day.ms += end - start; }\n            if (seg.v > s.min_run_power) day.running_ms += end - start;\n            start = end;\n        }\n    });\n    return days;\n}\n\nconst outside = perDay(msg.segments.outside);\nconst water = perDay(msg.segments.water);\nconst power = perDay(msg.segments.power);\nconst cop = perDay(msg.segments.cop, v => v > 0); // do not average the 0 values\n\nconst avg = (d) => d && d.ms > 0 ? d.sum / d.ms : undefined;\nconst covered = (d) => d && d.covered_ms >= s.min_day_coverage * DAY_MS;\n\nmsg.days_history = {};\nfor (const key in power) {\n    if (key === today || !covered(power[key]) || !covered(outside[key])) continue;\n    const powerAvg = avg(power[key]); // hours without data count as the measured hours\n    msg.days_history[key] = {\n        source: \"history\",\n        outside_temp_avg: round(avg(outside[key]), 1),\n        water_target_temp_avg: round(avg(water[key]), 1),\n        power_avg: round(powerAvg, 0),\n        energy: round(powerAvg * 24 / 1000, 2),\n        running_hours: round(power[key].running_ms / HOUR_MS, 1),\n        cop_avg: round(avg(cop[key]), 2),\n        ran: power[key].running_ms > 0,\n    };\n}\n\ndelete msg.segments;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
