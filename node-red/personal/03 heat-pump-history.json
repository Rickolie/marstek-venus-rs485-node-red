    {
        "type": "function",
        "name": "Statistics per day",
        "func": "const DAY_MS = 86_400_000;\nconst HOUR_MS = 3_600_000;\nconst pad = (v) => String(v).padStart(2, \"0\");\nconst dayKey = (t) => { const d = new Date(t); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; };\nconst round = (v, digits) => (v === undefined || !isFinite(v)) ? undefined : Number(v.toFixed(digits));\nconst mean = (values) => values.length ? values.reduce((a, b) => a + b, 0) / values.length : undefined;\nconst today = dayKey(Date.now()); // incomplete, never used\n\n// Hourly long-term statistics -> per local day. Fills in the days the recorder has purged.\n// The hourly COP mean includes the 0 values while the heat pump is off. Hours with min > 0\n// ran the full hour and give a clean COP; only when a day has none, hours with mean > 0 are used.\nconst s = msg.settings;\nconst statistics = msg.statistics || {};\nfunction hoursPerDay(rows) {\n    const days = {};\n    (rows || []).forEach(r => {\n        const h = { mean: parseFloat(r.mean), min: parseFloat(r.min), max: parseFloat(r.max) };\n        const t = typeof r.start === \"number\" ? r.start : new Date(r.start).getTime();\n        if (isFinite(h.mean)) (days[dayKey(t)] ??= []).push(h);\n    });\n    return days;\n}\n\nconst outside = hoursPerDay(statistics[s.entity.outside]);\nconst water = hoursPerDay(statistics[s.entity.water]);\nconst power = hoursPerDay(statistics[s.entity.power]);\nconst cop = hoursPerDay(statistics[s.entity.cop]);\n\nconst enough = (hours) => hours && hours.length >= s.min_day_coverage * 24;\n\nmsg.days_statistics = {};\nfor (const key in power) {\n    if (key === today || !enough(power[key]) || !enough(outside[key])) continue;\n    const p = power[key];\n    const c = cop[key] || [];\n    const copHours = c.some(h => h.min > 0) ? c.filter(h => h.min > 0) : c.filter(h => h.mean > 0);\n    const powerAvg = mean(p.map(h => h.mean));\n    msg.days_statistics[key] = {\n        source: \"statistics\",\n        outside_temp_avg: round(mean(outside[key].map(h => h.mean)), 1),\n        water_target_temp_avg: round(mean((water[key] || []).map(h => h.mean)), 1),\n        power_avg: round(powerAvg, 0),\n        energy: round(powerAvg * 24 / 1000, 2),\n        running_hours: p.filter(h => h.mean > s.min_run_power).length, // approximation\n        cop_avg: round(mean(copHours.map(h => h.mean)), 2),\n        ran: p.some(h => h.max > s.min_run_power),\n    };\n}\n\ndelete msg.statistics;\nreturn msg;",
