    {
        "type": "function",
        "name": "Time segments",
        "func": "// State history -> time segments per sensor: [{ start, end, v }]\n// A state is valid until the next state change. Unknown / unavailable states become gaps.\nconst now = Date.now();\nconst entity = msg.settings.entity;\nconst history = msg.history || {};\nconst toMs = (t) => typeof t === \"number\" ? (t < 1e12 ? t * 1000 : t) : new Date(t).getTime();\n\nfunction toSegments(states) {\n    const points = (states || [])\n        .map(s => ({ t: toMs(s.last_changed ?? s.lc ?? s.lu ?? s.last_updated), v: parseFloat(s.state ?? s.s) }))\n        .filter(p => isFinite(p.t))\n        .sort((a, b) => a.t - b.t);\n\n    const segments = [];\n    points.forEach((p, i) => {\n        const end = (i < points.length - 1) ? points[i + 1].t : now;\n        if (isFinite(p.v) && end > p.t) segments.push({ start: p.t, end: end, v: p.v });\n    });\n    return segments;\n}\n\nmsg.segments = {};\nfor (const key in entity) msg.segments[key] = toSegments(history[entity[key]]);\n\ndelete msg.history; // large, not needed anymore\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
