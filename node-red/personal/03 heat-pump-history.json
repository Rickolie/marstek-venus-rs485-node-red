    {
        "type": "function",
        "name": "Fit lines",
        "func": "// Least squares fit per value: value = slope * outside_temp + intercept\nconst round = (v, digits) => Number(v.toFixed(digits));\n\nfunction fit(key) {\n    const pts = msg.days.filter(d => d[key] !== undefined && d.outside_temp_avg !== undefined);\n    const n = pts.length;\n    if (n < 2) return undefined;\n    const mx = pts.reduce((s, d) => s + d.outside_temp_avg, 0) / n;\n    const my = pts.reduce((s, d) => s + d[key], 0) / n;\n    const sxx = pts.reduce((s, d) => s + (d.outside_temp_avg - mx) ** 2, 0);\n    const sxy = pts.reduce((s, d) => s + (d.outside_temp_avg - mx) * (d[key] - my), 0);\n    if (sxx === 0) return undefined;\n    return { slope: round(sxy / sxx, 3), intercept: round(my - sxy / sxx * mx, 2), days: n };\n}\n\nmsg.fit = {\n    water_target_temp: fit(\"water_target_temp_avg\"),\n    power: fit(\"power_avg\"),\n    cop: fit(\"cop_avg\"),\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
