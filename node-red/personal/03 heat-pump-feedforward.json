    {
        "type": "function",
        "name": "Feedforward",
        "func": "// logger, usage: log(this, \"\");\nconst log = global.get('logger');\n\n// 1.  Settings\n// Below this water temperature the heating curve is replaced by the simple day schedule:\n// heat at this temperature from the start time until the inside temperature is reached.\nconst SIMPLE_WATER_TEMP = 24; // °C\nconst MAX_FORECAST_AGE_H = 3;  // older cached forecasts are not used\n\n// 2.  Input\nconst ff = msg.feedforward || {};\nconst outside = parseFloat(ff.outside_temp);\nconst outsideAvg = parseFloat(ff.outside_temp_avg);\nconst inside = parseFloat(ff.inside_temp);\nconst minWater = parseFloat(ff.min_water_temp);\nconst maxWater = parseFloat(ff.max_water_temp);\nconst simpleFrom = parseFloat(ff.simple_outside_temp);\nconst simpleStop = parseFloat(ff.simple_stop_inside_temp);\nconst leadTime = parseFloat(ff.forecast_lead_time) || 0;       // h ahead\nconst window = parseFloat(ff.forecast_window) || 0;            // h averaged, from the lead time\nconst weight = parseFloat(ff.forecast_weight);                 // % forecast, rest current temperature\nconst simpleHours = parseFloat(ff.simple_forecast_hours) || 24; // h ahead, average for the simple schedule\nconst correctBias = ff.forecast_bias_correction === \"on\";       // shift the forecast to the measured temperature\nconst history = global.get(\"heat_pump_history\");\nconst forecast = flow.get(\"weather_forecast\"); // { fetched, list: [{ t, temp }] }\n\nconst HOUR_MS = 3_600_000;\nconst now = Date.now();\n\nif (!isFinite(outside)) {\n    log(this, \"Outside temperature unavailable\", \"warn\");\n    node.status({ fill: \"red\", shape: \"ring\", text: \"No outside temperature\" });\n    return null;\n}\n\nconst round = (v, digits) => (v === null || v === undefined || !isFinite(v)) ? null : Number(v.toFixed(digits));\n\n// 3.  Outside temperature: current or forecast\n// Forecast temperature at time t, linear between the hourly forecast points\nfunction forecastAt(t) {\n    const list = forecast.list;\n    if (t <= list[0].t) return list[0].temp;\n    for (let i = 1; i < list.length; i++) {\n        if (t <= list[i].t) {\n            const a = list[i - 1], b = list[i];\n            return a.temp + (b.temp - a.temp) * (t - a.t) / (b.t - a.t);\n        }\n    }\n    return list[list.length - 1].temp;\n}\n// Average forecast temperature over [from, from + hours], sampled every 15 minutes\nfunction forecastAverage(from, hours) {\n    const steps = Math.max(1, Math.round(hours * 4));\n    let sum = 0;\n    for (let i = 0; i < steps; i++) sum += forecastAt(from + (i + 0.5) * hours * HOUR_MS / steps);\n    return hours > 0 ? sum / steps : forecastAt(from);\n}\n\nlet outsideSource = ff.outside_source || \"Current\";\nlet outsideUsed = outside;     // used for the heating curve\nlet outsideAvgUsed = outsideAvg; // used to activate the simple schedule\nlet forecastTemp = null;\nlet forecastBias = 0;\nif (outsideSource === \"Forecast\") {\n    const fresh = forecast && Array.isArray(forecast.list) && forecast.list.length > 0 &&\n        now - forecast.fetched < MAX_FORECAST_AGE_H * HOUR_MS;\n    if (fresh) {\n        // The heat pump sensor often differs from the weather forecast (sun, defrost, location):\n        // optionally shift the whole forecast by the difference measured right now\n        if (correctBias) forecastBias = outside - forecastAt(now);\n        forecastTemp = forecastAverage(now + leadTime * HOUR_MS, window) + forecastBias;\n        const w = isFinite(weight) ? Math.min(Math.max(weight, 0), 100) / 100 : 1;\n        outsideUsed = outside + w * (forecastTemp - outside);\n        outsideAvgUsed = forecastAverage(now, simpleHours) + forecastBias;\n    } else {\n        log(this, \"No recent weather forecast, using the current outside temperature\", \"warn\");\n        outsideSource = \"Current (forecast unavailable)\";\n    }\n}\n\nconst atOutside = (line) => line ? line.slope * outsideUsed + line.intercept : null;\n\n// 4.  Select the heating curve: water = slope * outside + intercept\nconst manual = { slope: parseFloat(ff.manual_slope), intercept: parseFloat(ff.manual_intercept) };\nconst historyFit = history?.fit?.water_target_temp;\n\nlet source = ff.source;\nlet curve = manual;\nif (source === \"History\") {\n    if (historyFit) {\n        curve = historyFit;\n    } else {\n        // History not calculated yet (e.g. just after a restart), fall back to the manual curve\n        log(this, \"No history curve available, using manual values\", \"warn\");\n        source = \"Manual (history unavailable)\";\n    }\n}\n\nif (!isFinite(curve.slope) || !isFinite(curve.intercept)) {\n    log(this, \"Heating curve incomplete\", \"warn\");\n    node.status({ fill: \"red\", shape: \"ring\", text: \"No heating curve\" });\n    return null;\n}\n\n// 5a. Curve: feedforward water temperature, limited to min / max\nlet mode = \"Curve\";\nlet heating = true;\nlet water = atOutside(curve);\nif (isFinite(minWater)) water = Math.max(water, minWater);\nif (isFinite(maxWater)) water = Math.min(water, maxWater);\n\n// 5b. Simple day schedule, effective from the set average outside temperature\nif (isFinite(outsideAvgUsed) && isFinite(simpleFrom) && outsideAvgUsed >= simpleFrom) {\n    mode = \"Simple\";\n    water = SIMPLE_WATER_TEMP;\n\n    // The heating day starts at the start time, before that time the previous day still counts\n    const [h, m] = String(ff.simple_start_time || \"00:00\").split(\":\").map(Number);\n    const today = new Date(now);\n    const start = new Date(today.getFullYear(), today.getMonth(), today.getDate(), h || 0, m || 0);\n    if (now < start.getTime()) start.setDate(start.getDate() - 1);\n    const heatingDay = start.toISOString();\n\n    // Stop for the rest of the heating day once the inside temperature is reached\n    if (flow.get(\"simple_stopped_day\") !== heatingDay) {\n        if (!isFinite(inside)) {\n            log(this, \"Inside temperature unavailable, keep heating\", \"warn\");\n        } else if (isFinite(simpleStop) && inside >= simpleStop) {\n            log(this, `Inside temperature ${inside} °C reached, stop heating for today`);\n            flow.set(\"simple_stopped_day\", heatingDay);\n        }\n    }\n    heating = flow.get(\"simple_stopped_day\") !== heatingDay;\n}\n\n// 6.  Output\nmsg.feedforward = {\n    ...ff,\n    outside_temp: outside,\n    outside_temp_avg: round(outsideAvg, 1),\n    outside_source: outsideSource,\n    forecast_temp: round(forecastTemp, 1),\n    forecast_bias: round(forecastBias, 1),\n    outside_temp_used: round(outsideUsed, 1),        // heating curve\n    outside_temp_avg_used: round(outsideAvgUsed, 1), // simple schedule\n    inside_temp: round(inside, 1),\n    source: source,\n    slope: curve.slope,\n    intercept: curve.intercept,\n    mode: mode,\n    heating: heating, // false: heat pump off for the rest of the heating day\n    water_temp: round(water, 1),\n    // expected values from the history at this outside temperature, for information\n    expected_power: round(atOutside(history?.fit?.power), 0),\n    expected_cop: round(atOutside(history?.fit?.cop), 2),\n};\n\nglobal.set(\"heat_pump_feedforward\", msg.feedforward);\n\nconst text = heating ? `${msg.feedforward.water_temp} °C` : \"Off for today\";\nnode.status({ fill: heating ? \"green\" : \"grey\", shape: \"dot\", text: `${text} @ ${round(outsideUsed, 1)} °C (${mode}, ${source}, ${outsideSource})` });\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
