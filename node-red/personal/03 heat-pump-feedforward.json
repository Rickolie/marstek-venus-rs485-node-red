    {
        "type": "function",
        "name": "Feedforward",
        "func": "// logger, usage: log(this, \"\");\nconst log = global.get('logger');\n\n// 1.  Settings\n// Below this water temperature the heating curve is replaced by the simple day schedule:\n// heat at this temperature from the start time until the inside temperature is reached.\nconst SIMPLE_WATER_TEMP = 24; // °C\n\n// 2.  Input\nconst ff = msg.feedforward || {};\nconst outside = parseFloat(ff.outside_temp);\nconst outsideAvg = parseFloat(ff.outside_temp_avg);\nconst inside = parseFloat(ff.inside_temp);\nconst minWater = parseFloat(ff.min_water_temp);\nconst maxWater = parseFloat(ff.max_water_temp);\nconst simpleFrom = parseFloat(ff.simple_outside_temp);\nconst simpleStop = parseFloat(ff.simple_stop_inside_temp);\nconst history = global.get(\"heat_pump_history\");\n\nif (!isFinite(outside)) {\n    log(this, \"Outside temperature unavailable\", \"warn\");\n    node.status({ fill: \"red\", shape: \"ring\", text: \"No outside temperature\" });\n    return null;\n}\n\nconst round = (v, digits) => (v === null || v === undefined || !isFinite(v)) ? null : Number(v.toFixed(digits));\nconst atOutside = (line) => line ? line.slope * outside + line.intercept : null;\n\n// 3.  Select the heating curve: water = slope * outside + intercept\nconst manual = { slope: parseFloat(ff.manual_slope), intercept: parseFloat(ff.manual_intercept) };\nconst historyFit = history?.fit?.water_target_temp;\n\nlet source = ff.source;\nlet curve = manual;\nif (source === \"History\") {\n    if (historyFit) {\n        curve = historyFit;\n    } else {\n        // History not calculated yet (e.g. just after a restart), fall back to the manual curve\n        log(this, \"No history curve available, using manual values\", \"warn\");\n        source = \"Manual (history unavailable)\";\n    }\n}\n\nif (!isFinite(curve.slope) || !isFinite(curve.intercept)) {\n    log(this, \"Heating curve incomplete\", \"warn\");\n    node.status({ fill: \"red\", shape: \"ring\", text: \"No heating curve\" });\n    return null;\n}\n\n// 4a. Curve: feedforward water temperature, limited to min / max\nlet mode = \"Curve\";\nlet heating = true;\nlet water = atOutside(curve);\nif (isFinite(minWater)) water = Math.max(water, minWater);\nif (isFinite(maxWater)) water = Math.min(water, maxWater);\n\n// 4b. Simple day schedule, effective from the set average outside temperature\nif (isFinite(outsideAvg) && isFinite(simpleFrom) && outsideAvg >= simpleFrom) {\n    mode = \"Simple\";\n    water = SIMPLE_WATER_TEMP;\n\n    // The heating day starts at the start time, before that time the previous day still counts\n    const [h, m] = String(ff.simple_start_time || \"00:00\").split(\":\").map(Number);\n    const now = new Date();\n    const start = new Date(now.getFullYear(), now.getMonth(), now.getDate(), h || 0, m || 0);\n    if (now < start) start.setDate(start.getDate() - 1);\n    const heatingDay = start.toISOString();\n\n    // Stop for the rest of the heating day once the inside temperature is reached\n    if (flow.get(\"simple_stopped_day\") !== heatingDay) {\n        if (!isFinite(inside)) {\n            log(this, \"Inside temperature unavailable, keep heating\", \"warn\");\n        } else if (isFinite(simpleStop) && inside >= simpleStop) {\n            log(this, `Inside temperature ${inside} °C reached, stop heating for today`);\n            flow.set(\"simple_stopped_day\", heatingDay);\n        }\n    }\n    heating = flow.get(\"simple_stopped_day\") !== heatingDay;\n}\n\n// 5.  Output\nmsg.feedforward = {\n    ...ff,\n    outside_temp: outside,\n    outside_temp_avg: round(outsideAvg, 1),\n    inside_temp: round(inside, 1),\n    source: source,\n    slope: curve.slope,\n    intercept: curve.intercept,\n    mode: mode,\n    heating: heating, // false: heat pump off for the rest of the heating day\n    water_temp: round(water, 1),\n    // expected values from the history at this outside temperature, for information\n    expected_power: round(atOutside(history?.fit?.power), 0),\n    expected_cop: round(atOutside(history?.fit?.cop), 2),\n};\n\nglobal.set(\"heat_pump_feedforward\", msg.feedforward);\n\nconst text = heating ? `${msg.feedforward.water_temp} °C` : \"Off for today\";\nnode.status({ fill: heating ? \"green\" : \"grey\", shape: \"dot\", text: `${text} @ ${outside} °C (${mode}, ${source})` });\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
