    {
        "type": "function",
        "name": "Cache forecast",
        "func": "// logger, usage: log(this, \"\");\nconst log = global.get('logger');\n\n// Cache the hourly forecast as [{ t: ms, temp: °C }], read by the 'Feedforward' node\nconst response = msg.payload || {};\nconst list = (response[\"weather.forecast_home\"] ?? Object.values(response)[0])?.forecast;\n\nif (!Array.isArray(list) || list.length === 0) {\n    log(this, \"Weather forecast missing or empty\", \"warn\");\n    node.status({ fill: \"red\", shape: \"ring\", text: \"No forecast\" });\n    return null;\n}\n\nconst points = list\n    .map(f => ({ t: new Date(f.datetime).getTime(), temp: parseFloat(f.temperature) }))\n    .filter(p => isFinite(p.t) && isFinite(p.temp))\n    .sort((a, b) => a.t - b.t);\n\nflow.set(\"weather_forecast\", { fetched: Date.now(), list: points });\nnode.status({ fill: \"green\", shape: \"dot\", text: `${points.length} hours, now ${points[0]?.temp} °C` });\n\n// Recalculate the feedforward with the new forecast\nreturn {};\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 230,
        "y": 320,
        "wires": [
            [
                "3bed5c43fbcf1646"
            ]
        ],
        "id": "e2dbc390e59da5d7",
        "z": "30c1cadb3f5445db",
        "g": "d2939b7cf9bdd0eb"
    },
